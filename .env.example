# NPS Web 管理 API 地址（仅后端访问）
NPS_BASE_URL=http://39.101.76.106:8080
NPS_AUTH_KEY=your_nps_api_auth_secret
NPS_PUBLIC_HOST=39.101.76.106
# 可分配公网 IP（逗号分隔，单服务器填一个即可）
NPS_PUBLIC_HOSTS=39.101.76.106
# 创建端口映射时使用的 NPS 客户端 ID（必填）
DEFAULT_NPS_CLIENT_ID=7

# 初始管理员（首次启动写入数据库，之后请在「用户管理」中维护）
PORTAL_USERNAME=admin
PORTAL_PASSWORD=admin123
JWT_SECRET=change-me-in-production

# 设备前缀过滤（NPS 侧，留空=全部）
ALLOWED_REMARK_PREFIX=auto-
MASK_CLIENT_IP=true

# 用户自助申请端口映射 — 使用时长（分钟）
USER_TTL_MIN_MINUTES=5
USER_TTL_MAX_MINUTES=1440
USER_TTL_DEFAULT_MINUTES=720

# 自动分配公网端口范围（1-65535，避开 blocklist 中的保留端口）
AUTO_PORT_START=1
AUTO_PORT_END=65535
AUTO_PORT_BLOCKLIST=8080,8088,18000,18022
AUTO_PORT_SOCKET_CHECK=false

# 目标地址限制
ALLOW_CUSTOM_TARGET_HOST=true
TARGET_HOST_WHITELIST=127.0.0.1,localhost

# 并发映射上限
MAX_RUNNING_MAPPINGS_PER_USER=3
MAX_RUNNING_MAPPINGS_TOTAL=200

# 遗留 ACL 模式端口池（每类 500 个）
DEFAULT_TUNNEL_TTL_MINUTES=1440
MAX_TUNNEL_TTL_MINUTES=43200
ENABLE_CUSTOM_TARGET_PORT=false
DEFAULT_SSH_USER=ant
CLEANUP_INTERVAL_SECONDS=60
SSH_PORT_START=18023
SSH_PORT_END=18522
WEB_PORT_START=18523
WEB_PORT_END=19022
GDB_PORT_START=19023
GDB_PORT_END=19522
TEMP_PORT_START=19523
TEMP_PORT_END=20022

# 门户端口
PORTAL_PORT=8088

# 数据目录（Docker 内默认 /app/data，已挂载 volume）
DATA_DIR=./data
